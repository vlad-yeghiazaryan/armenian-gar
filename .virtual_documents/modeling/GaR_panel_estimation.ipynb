# fitting QR the model
panel_qcoef = []
panel_qcoef_norm = []
panel_qr_pred = []
for index, y_name in enumerate(Y):
    horizon = int(float(y_name[-2])*4)
    endog = Y[y_name].copy()
    macro_data = pd.concat([Ar.iloc[:, index], exog], axis=1).dropna()
    macro_data = pd.concat([endog, macro_data], axis=1)

    # !! subjective step removing some problem countires from estimation set !!
    rmc = ~macro_data.index.get_level_values('country').isin(problem_countries_2)
    macro_data = macro_data.loc[rmc].copy()
    # comment out to see complete results

    # interpolate over some inf columns
    macro_data = macro_data.groupby('country').transform(lambda x: x.replace([np.inf, -np.inf], np.nan).interpolate())

    macro_data = macro_data.reset_index()
    quantfit_out = run_quantfit(macro_data, target=y_name, horizon=horizon,
                                model_fit_args={'max_iter': 10000, 'p_tol': 1e-06},
                                model=sm.QuantReg, quantlist=quantlist)
    panel_qcoef.append(quantfit_out['localprj'])
    panel_qcoef_norm.append(quantfit_out['qcoef'])
    panel_qr_pred.append(quantfit_out['cond_quant'])
panel_qcoef = pd.concat(panel_qcoef)
panel_qcoef['variable'] = panel_qcoef['variable'].replace({
    'autoregressive_1y': 'autoregressive',
    'autoregressive_2y': 'autoregressive',
    'autoregressive_3y': 'autoregressive'
})
panel_qcoef = panel_qcoef.set_index(['horizon', 'variable', 'quantile'])
panel_qcoef_norm = pd.concat(panel_qcoef_norm).set_index(['horizon', 'variable', 'quantile'])
panel_qr_pred = pd.concat(panel_qr_pred).reset_index().set_index(['horizon', 'country', 'tau', 'date'])


