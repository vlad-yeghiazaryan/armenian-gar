class RFFS():
    """
    Recursive Filtered Feature Selector
    """

    def __init__(self, model=sm.QuantReg, model_params={'q': 0.5},
                 n_models=10, n_retries=4, max_n_improvements=100,
                 dynamic_filtering=True, metric='prsquared',
                 fixed_columns=[], column_groups={}):
        self.model_params = model_params
        self.model = model
        self.n_models = n_models
        self.n_retries = n_retries
        self.max_n_improvements = max_n_improvements
        self.dynamic_filtering = dynamic_filtering
        self.metric = metric
        self.fixed_columns = fixed_columns
        self.column_groups = column_groups
        self.cg_map = {x: i for i, xs in column_groups.items() for x in xs}
        self.selected_columns = []
        self.search_results = []
        self.base_model = None
        self.base_metric = None
        self.base_res = None
        self.next_feature = None
        self.retry_count = 0
        self.update_count = 0
        self.progress_bar = tqdm(total=n_models, disable=True)

    def fit_model(self, X, y):
        base_model = self.model(y, X).fit(**self.model_params)
        base_metric = getattr(base_model, self.metric)
        base_res = base_model.resid
        return base_model, base_metric, base_res

    def feature_grid_search(self, X, y, next_features):
        feature_improvements = []
        base_metric = np.NaN if isinstance(self.base_metric, type(None)) else self.base_metric
        feature_space = next_features.index[:self.n_models]
        for f in feature_space:
            X_new = X[self.selected_columns+[f]].dropna()
            y_new = y.loc[X_new.index]
            with warnings.catch_warnings(record=True) as w:
                improved_model, improved_metric, improved_res = self.fit_model(X_new, y_new)
            w = np.NaN if len(w) == 0 else w[0]
            improvement = {
                'Feature': f, self.metric: improved_metric,
                f'base_{self.metric}': base_metric,
                'Model': improved_model,
                'Residuals': improved_res,
                'Warning': w,
                **next_features.loc[f].to_dict()
            }
            feature_improvements.append(improvement)
            self.progress_bar.update(1)
        feature_improvements = pd.DataFrame(feature_improvements).sort_values(self.metric, ascending=False)
        return feature_improvements

    def get_improvement_scores(self, corr_table):
        default = corr_table.iloc[:, -1]
        if (len(self.search_results) == 0) or (self.dynamic_filtering == False):
            return default
        else:
            # sr = self.search_results[-1]
            sr = pd.concat(self.search_results).reset_index(drop=True)
            sr['improvement'] = sr['prsquared'] - sr['base_prsquared']
            if sr['improvement'].isna().all():
                return default
            sr = sr.loc[:, list(corr_table.columns)+['improvement']].copy()
            sr_corr = sr.corr()
            sr_imp = sr_corr['improvement'].iloc[:-1]
            scorer = sr_imp.abs().idxmax()
            value = sr_imp.loc[scorer]
            score = corr_table[scorer] if value > 0 else -corr_table[scorer]
            return score

    def select_best_features(self, X, y):
        searched_subset = list(self.selected_family.intersection(X.columns))
        X_subset = X.drop(columns=searched_subset)
        data = pd.concat([y, X], axis=1)
        if not X_subset.empty:
            corr_target = X_subset.corrwith(y).abs()
            pcorr_target = [pg.partial_corr(data=data, x=c, y=y.name,
                                            covar=self.selected_columns).iloc[0, 1] for c in X_subset.columns]
            pcorr_target = pd.Series(pcorr_target, index=X_subset.columns).abs()
            corr_resid = X_subset.corrwith(self.base_res).abs()
            corr_other = pd.concat([X[self.selected_columns].corrwith(X[c]).rename(c) for c in X_subset], axis=1).abs()
            corr_other_mean = corr_other.mean()
            corr_other_std = corr_other.std()
            corr_table = pd.concat([corr_target.rename('corr_target'),
                                    pcorr_target.rename('partial_corr_target'),
                                    corr_resid.rename('corr_resid'),
                                    corr_other_mean.rename('corr_other_mean'),
                                    corr_other_std.rename('corr_other_std')], axis=1)
            # alternative scoring options
            corr_table['corr_resid_adj'] = corr_table['corr_resid']*(1 - corr_table['corr_other_mean'])
            corr_table['corr_other_adj'] = (-(1 - corr_table['corr_other_mean'])**256)/corr_table['corr_other_std']
            corr_table['partial_corr_adj'] = np.cos(corr_table['partial_corr_target']**2 - np.sin(corr_table['corr_other_std']) - corr_table['corr_other_std'])

            # scoring and sorting based on the score
            corr_table['score'] = self.get_improvement_scores(corr_table)
            next_features = corr_table.dropna().sort_values('score', ascending=False)
            return next_features
        else:
            return None

    def update_base_model(self, best_model=None):
        if best_model:
            self.update_count += 1
            self.selected_columns.append(best_model['Feature'])
            self.base_model = best_model['Model']
            self.base_metric = best_model[self.metric]
            self.base_res = best_model['Residuals']
            self.next_feature = best_model['Feature']
        if not self.progress_bar.disable:
            self.progress_bar.set_description(f"Current {self.metric}: {round(self.base_metric, 3)}")
            self.progress_bar.total += self.n_models
            self.progress_bar.refresh()
        self.selected_family = [self.column_groups[self.cg_map[c]] if c in self.cg_map else [c] for c in self.selected_columns]
        self.selected_family = {x for xs in self.selected_family for x in xs}

    def get_best_model(self, X, y, next_features=None):
        # Step 3: select the top n features with the highest correlation with resid
        if isinstance(next_features, type(None)):
            next_features = self.select_best_features(X, y)
            if isinstance(next_features, type(None)):
                return None

        # Step 4: fit a new model with each feature and measure the loss metric
        # Also, remove specifications for which the model did not converge (warnings)
        # if all models didn't converge, then try the next best n features, with k reties
        feature_improvements = self.feature_grid_search(X, y, next_features)
        self.search_results.append(feature_improvements.copy())
        feature_improvements = feature_improvements[feature_improvements['Warning'].isna()]
        available = next_features.shape[0] >= self.n_models*2
        can_retry = self.retry_count <= self.n_retries
        if feature_improvements.empty:
            if available and can_retry:
                self.update_base_model()
                best_result = self.get_best_model(X, y, next_features.iloc[self.n_models:])
            else:
                return None
        else:
            # Step 5: select an improved model with the highest loss metric
            best_result = feature_improvements.iloc[0].to_dict()
        return best_result

    def fit(self, X, y):
        # Step 1: fit a base model and calculate the residuals and the loss metric
        self.update_count = 0
        self.search_results = []
        self.selected_columns = list(X.columns.intersection(self.fixed_columns))
        self.update_base_model()
        self.base_res = y
        best_result = self.get_best_model(X, y)
        self.update_base_model(best_result)

        # Step 2: iteratively loop over the improving model and identify the best set of features
        improving = True
        self.progress_bar = tqdm(total=self.n_models, desc=f"Current {self.metric}: {round(self.base_metric, 3)}")
        while improving:
            # Steps 3, 4, 5
            best_result = self.get_best_model(X, y)
            improved_metric = best_result[self.metric] if best_result else self.base_metric

            # Step 6: if the improved model has a lower loss metric then select the base and halt
            if (improved_metric <= self.base_metric) or (self.update_count > self.max_n_improvements):
                improving = False
            else:
                self.update_base_model(best_result)
        self.search_results = pd.concat(self.search_results).reset_index(drop=True)
        self.search_results['improvement'] = self.search_results['prsquared'] - self.search_results['base_prsquared']
        self.progress_bar.close()


